{
  // markdownlint-cli2, pinned at 0.23.3 — the version CI runs and the version
  // every local invocation must name:
  //
  //   npx markdownlint-cli2@0.23.3
  //
  // The engine's default rule set stands except for the deviations below.
  // Each one names the repository convention it would otherwise fight; a rule
  // is withheld only where the fix would rewrite bytes the charter's laws or
  // the crate's fences own (LAW-EVIDENCE-FILES quotations, Documents tables,
  // the verification ledger), never to spare a mechanical cleanup.
  "globs": [
    "**/*.md"
  ],
  "gitignore": true,
  "config": {
    // The repository hard-wraps its own prose, but the evidence corpus quotes
    // operator documents verbatim and carries wide `### Documents` tables, so
    // no line-length limit can hold everywhere and rewrapping quotations is
    // forbidden. Code width stays with rustfmt, prose width with convention.
    "MD013": false,
    // Keep a Changelog repeats `### Added` / `### Fixed` under every release
    // heading, and those sections are not siblings; duplicates inside one
    // section remain errors.
    "MD024": { "siblings_only": true },
    // The tables this repository writes are `| cell |` rows over `|---|`
    // separators; the whole corpus already satisfies this style, so the gate
    // enforces it instead of inferring one per document.
    "MD060": { "style": "leading_and_trailing" },
    // `<a id="...">` anchors in docs/schedules/sources.md and `<br>` breaks
    // inside verification-ledger table cells are deliberate. The remaining
    // names are angle-bracket placeholders inside quoted operator shapes
    // ("Market holidays ... for <year>"), not HTML elements — altering them
    // would rewrite quotations.
    "MD033": { "allowed_elements": ["a", "br", "time", "date", "day", "holiday", "year"] }
  },
  "overrides": [
    {
      // Evidence files record operator quotations and retrieval URLs verbatim:
      // a hard-wrapped quotation can begin a continuation line with `- `
      // (MD032), bare retrieval URLs are citation content (MD034), quoted
      // footnote markers such as `21:00*` read as emphasis (MD037), and each
      // audited era repeats `### Documents` (MD024) — the exact heading the
      // digest fence and `cargo xtask verify-evidence` read.
      "filter": [
        "docs/evidence/**/*.md"
      ],
      "combine": "merge",
      "config": {
        "MD024": false,
        "MD032": false,
        "MD034": false,
        "MD037": false
      }
    },
    {
      // The verification ledger's fixed-shape rows quote NSE series names
      // (`FN*`, `F*`, `E*`, `MCN*`) whose asterisks are the operator's own;
      // the row basis is not to be reworded for a linter.
      "filter": [
        "docs/schedules/verification.md"
      ],
      "combine": "merge",
      "config": {
        "MD037": false
      }
    }
  ]
}
